# LessonViewer 모듈 설정 예시. 이 파일을 .env 로 복사해서 씀(.env 는 git 에 올라가지 않음).
# bun 은 StudyApp 폴더의 .env 를 자동으로 읽음. 설정은 서버가 켜질 때 한 번만 읽힘.

# 모델 제공자: anthropic(네이티브 Messages API) | openai-compatible(Chat Completions 호환)
LESSONVIEWER_PROVIDER=anthropic
LESSONVIEWER_MODEL=claude-haiku-5-5
# 기본값: anthropic → https://api.anthropic.com, openai-compatible → https://api.openai.com/v1
# 계정 정보·?query·#fragment 가 들어간 주소는 거부되고 모듈이 꺼짐(키를 엉뚱한 곳으로 보내지 않음)
# LESSONVIEWER_API_BASE_URL=

# API 키. 둘 중 하나만:
#  - 서비스 배포: 비밀 관리 도구가 넣어 주는 환경 변수
# LESSONVIEWER_API_KEY=
#  - 이 컴퓨터: 키를 파일에 쓰지 않고 `pkh get <참조>` 로 서버 시작 때 한 번 읽음(LESSONVIEWER_API_KEY 가 있으면 그게 우선)
# LESSONVIEWER_KEY_REF=api.anthropic.key

# 외부 호스트 서버가 /api/module 을 부를 때 쓰는 토큰(32자 이상). 비워 두면 로컬 전용
# 만들기: openssl rand -hex 32
# LESSONVIEWER_HOST_TOKEN=

# 듣는 주소. 기본은 127.0.0.1 과 ::1 (이 컴퓨터만). 호스트 연동 때만 예: 0.0.0.0
# LESSONVIEWER_BIND=
# PORT=5178

# 모듈 데이터(올린 PDF, 생성 결과, 대화) 위치. 기본 data/module
# LESSONVIEWER_DATA_DIR=
# 기존 진도·필기 DB 위치. 기본 data/study.db (시험할 때 임시 파일로 바꿀 수 있음)
# LESSONVIEWER_STUDY_DB=
# PDF 추출에 쓸 파이썬(PyMuPDF 필요). 기본 ../.venv/bin/python, 없으면 python3
# LESSONVIEWER_PYTHON=

# 선택: 0 이면 모델에 쪽 이미지를 보내지 않음(글만)
# LESSONVIEWER_VISION=1
# 대화 답 하나에서 자료를 찾아보는 최대 횟수(0~8, 기본 4)와 답 최대 토큰(256~8192, 기본 2048)
# LESSONVIEWER_CHAT_MAX_STEPS=4
# LESSONVIEWER_CHAT_MAX_TOKENS=2048
# 동시에 돌리는 해설 생성 작업 수(1~4, 기본 1)
# LESSONVIEWER_JOB_CONCURRENCY=1
# 업로드 상한(바이트). 50MB 보다 낮추기만 가능
# LESSONVIEWER_MAX_FILE_BYTES=52428800
